# ===== 開発用のサンプル（秘密情報は入れないこと） =====
APP_NAME="Phoenix Partner Selection"
# local / production。production では開発用の設定（Mailpit・テスト予約・デバッグ）を使うと起動しない
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Tokyo

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=partner
DB_USERNAME=partner
DB_PASSWORD=partner

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# 本番（https）では true
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# 開発用のローカル受信箱（Mailpit: http://localhost:8025）。本番では使えない
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.invalid"
MAIL_FROM_NAME="デザインスタジオフェニックス"

# テスト用予約画面（/dev/booking）を有効にする。本番では false 必須
PARTNER_DEV_TOOLS=true
# 既存フォームからの受付API用キー（32文字以上のランダム文字列。未設定なら API は使えない）
PARTNER_INTAKE_API_KEY=
PARTNER_MAX_APPLICATIONS_PER_EMAIL_PER_DAY=3

# リバースプロキシ配下で動かす場合のみ（例: 127.0.0.1）
TRUSTED_PROXIES=
